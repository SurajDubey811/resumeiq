# ResumeIQ Environment Configuration
# Copy this file to .env to customize settings

# Application settings
APP_NAME="ResumeIQ ATS Analyzer"
APP_VERSION="1.0.0"
DEBUG=false

# Upload constraints
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB in bytes
MIN_SCANNED_CHAR_THRESHOLD=80

# CORS Origins (comma-separated if set via environment)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# Optional AI Provider (Layer B)
# If left blank, ResumeIQ operates 100% locally with zero external network calls (Layer A)
GEMINI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=30
